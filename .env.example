# Required for production
TELEGRAM_BOT_TOKEN=123456789:replace_with_BotFather_token
OWNER_ID=123456789
# Optional comma-separated admins; owner is always admin
ADMIN_IDS=222222222,333333333
# Render sets RENDER_EXTERNAL_URL automatically; optional explicit override
# WEBAPP_URL=https://your-service.onrender.com
# Stable secret used by Telegram webhook. Render Blueprint generates this.
WEBHOOK_SECRET=replace_with_random_long_secret

# render.yaml attaches a paid persistent disk at /var/data for durable history.
DB_PATH=/var/data/ahmx_v4.sqlite3
DATA_DIR=/var/data
DOWNLOAD_DIR=/tmp/ahmx-v4
YTDLP_NODE_PATH=/usr/local/bin/node
LOG_LEVEL=INFO

# Optional YouTube fallback. Use only your own/authorized Cobalt API instance.
# The official Cobalt project says its hosted public APIs are not intended for integration
# into third-party projects without permission. Do not set this to an unauthorized public API.
COBALT_API_URL=
COBALT_API_KEY=

# Local browser testing only; never enable in production
ALLOW_DEV_WEBAPP_AUTH=0
DEV_USER_ID=123456789
