# Create your bot with @BotFather. Never commit the real token.
TELEGRAM_BOT_TOKEN=replace_me

# Use a random value with letters, digits, underscores or hyphens.
# Render Blueprint can generate this automatically.
WEBHOOK_SECRET=replace_with_a_long_random_secret

# Public HTTPS base URL. On Render, RENDER_EXTERNAL_URL is used automatically.
# WEBHOOK_URL=https://your-service.onrender.com

# Bot username WITHOUT the @ sign (used for the open-bot fallback link).
BOT_USERNAME=YourBotUsername

# Comma-separated Telegram user IDs allowed to see the admin panel.
ADMIN_IDS=

MAX_UPLOAD_MB=49
MAX_DIRECT_DOWNLOAD_MB=150
MAX_VIDEO_HEIGHT=1080
MAX_ACTIVE_DOWNLOADS=1
LOG_LEVEL=INFO

# Optional; Docker auto-detects Node.js. Override only if the binary is elsewhere.
# YTDLP_NODE_PATH=/usr/local/bin/node
